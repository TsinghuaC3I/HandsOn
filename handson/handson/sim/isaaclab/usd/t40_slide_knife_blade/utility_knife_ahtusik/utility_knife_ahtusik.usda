#usda 1.0
(
    defaultPrim = "Asset"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "Asset" (
    customData = {
        string "handson:animationPolicy" = "source animation inspected for travel only; not authored as physics"
        string "handson:assetId" = "as013-sketchfab-ahtusik"
        string "handson:axisMapping" = "[-x, z, y] * 0.008 (det=+1, orientation-preserving; source glTF world -> AS013 metres)"
        string "handson:bladeEnvelopeMethod" = "baked_blade_y_fit_to_retracted_housing_envelope"
        double "handson:bladeRetractedClearanceM" = 0.004
        double "handson:buttonTargetProtrusionM" = 0.0025
        double "handson:buttonTargetWidthM" = 0.023
        double "handson:conversionScale" = 0.008
        string "handson:ergonomicScaleXYZ" = "1.3,1.3,2.35"
        string "handson:license" = "CC-BY-4.0"
        string "handson:sourceArchiveSha256" = "85fe8c49f43383aa15e5ea9803dfca52fec196d3dc00424ea8eaaca326aa648b"
        string "handson:sourceAuthor" = "ahtusik"
        string "handson:sourceSceneSha256" = "7e155ea959934f7d37380e1d0eb5f35d0d36076dd71d063f68b66acc5b8100ee"
        string "handson:sourceTitle" = "Utility Knife"
        string "handson:sourceUrl" = "https://sketchfab.com/3d-models/utility-knife-083c2d52b3d04eedb5350cce6e2d1b92"
    }
)
{
    def Scope "Looks"
    {
        def Material "UtilityKnifeMaterial" (
            customData = {
                dictionary handson = {
                    string sourceTextures = "textures/Material.001_baseColor.png;textures/Material.001_metallicRoughness.png;textures/Material.001_normal.png"
                }
            }
        )
        {
            token outputs:surface.connect = </Asset/Looks/UtilityKnifeMaterial/PreviewSurface.outputs:surface>

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor.connect = </Asset/Looks/UtilityKnifeMaterial/BaseColorTexture.outputs:rgb>
                float inputs:ior = 1.45
                float inputs:metallic.connect = </Asset/Looks/UtilityKnifeMaterial/MetallicRoughnessTexture.outputs:b>
                normal3f inputs:normal.connect = </Asset/Looks/UtilityKnifeMaterial/NormalTexture.outputs:rgb>
                float inputs:opacity = 1
                float inputs:roughness.connect = </Asset/Looks/UtilityKnifeMaterial/MetallicRoughnessTexture.outputs:g>
                token outputs:surface
            }

            def Shader "stReader"
            {
                uniform token info:id = "UsdPrimvarReader_float2"
                token inputs:varname = "st"
                float2 outputs:result
            }

            def Shader "BaseColorTexture"
            {
                uniform token info:id = "UsdUVTexture"
                asset inputs:file = @textures/Material.001_baseColor.png@
                token inputs:sourceColorSpace = "sRGB"
                float2 inputs:st.connect = </Asset/Looks/UtilityKnifeMaterial/stReader.outputs:result>
                float outputs:a
                float outputs:b
                float outputs:g
                float outputs:r
                float3 outputs:rgb
            }

            def Shader "MetallicRoughnessTexture"
            {
                uniform token info:id = "UsdUVTexture"
                asset inputs:file = @textures/Material.001_metallicRoughness.png@
                token inputs:sourceColorSpace = "sRGB"
                float2 inputs:st.connect = </Asset/Looks/UtilityKnifeMaterial/stReader.outputs:result>
                float outputs:a
                float outputs:b
                float outputs:g
                float outputs:r
                float3 outputs:rgb
            }

            def Shader "NormalTexture"
            {
                uniform token info:id = "UsdUVTexture"
                asset inputs:file = @textures/Material.001_normal.png@
                token inputs:sourceColorSpace = "raw"
                float2 inputs:st.connect = </Asset/Looks/UtilityKnifeMaterial/stReader.outputs:result>
                float outputs:a
                float outputs:b
                float outputs:g
                float outputs:r
                float3 outputs:rgb
            }
        }
    }

