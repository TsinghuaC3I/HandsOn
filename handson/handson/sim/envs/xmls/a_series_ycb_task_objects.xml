    <body name="spoon" pos="-0.28 -0.26 0.931">
      <freejoint name="spoon_joint" />
      <geom name="spoon_visual" class="a_series_ycb_visual" material="spoon_material" mesh="spoon_vis" />
      <!-- The scanned bowl hulls form a high vertical lip that pushes a marble
           instead of sliding beneath it. Hull 2 overlaps the proxy at the neck
           and can squeeze a marble during pouring; hull 3 retains the handle;
           the thin proxy bowl below provides the interaction surface. -->
      <!-- The rendered spoon is widened 1.2x in X.  Apply the same scale to
           the authored collision hulls or the hand/marble can visibly enter
           the bowl wall before PhysX sees contact. -->
      <geom name="spoon_collision_1" class="a_series_ycb_collision" mesh="spoon_Collider1_m_collision" mass="0.0029166667" contype="0" conaffinity="0" />
      <geom name="spoon_collision_2" class="a_series_ycb_collision" mesh="spoon_Collider2_m_collision" mass="0.0029166667" contype="0" conaffinity="0" />
      <geom name="spoon_collision_3" class="a_series_ycb_collision" mesh="spoon_Collider3_m_collision" mass="0.0029166667" />
      <geom name="spoon_collision_4" class="a_series_ycb_collision" mesh="spoon_Collider4_m_collision" mass="0.0029166667" contype="0" conaffinity="0" />
      <!-- Re-enable the YCB front-lip hulls.  These three convex pieces follow
           the scanned rounded leading edge; the invisible proxy remains only
           the bowl floor/side retention surface. -->
      <geom name="spoon_collision_5" class="a_series_ycb_collision" mesh="spoon_Collider5_m_collision" mass="0.0029166667" contype="8" conaffinity="4" />
      <geom name="spoon_collision_6" class="a_series_ycb_collision" mesh="spoon_Collider6_m_collision" mass="0.0029166667" contype="0" conaffinity="0" />
      <geom name="spoon_collision_7" class="a_series_ycb_collision" mesh="spoon_Collider7_m_collision" mass="0.0029166667" contype="0" conaffinity="0" />
      <geom name="spoon_collision_8" class="a_series_ycb_collision" mesh="spoon_Collider8_m_collision" mass="0.0029166667" contype="0" conaffinity="0" />
      <geom name="spoon_collision_9" class="a_series_ycb_collision" mesh="spoon_Collider9_m_collision" mass="0.0029166667" contype="8" conaffinity="4" />
      <geom name="spoon_collision_10" class="a_series_ycb_collision" mesh="spoon_Collider10_m_collision" mass="0.0029166667" contype="0" conaffinity="0" />
      <geom name="spoon_collision_11" class="a_series_ycb_collision" mesh="spoon_Collider11_m_collision" mass="0.0029166667" contype="0" conaffinity="0" />
      <geom name="spoon_collision_12" class="a_series_ycb_collision" mesh="spoon_Collider12_m_collision" mass="0.0029166667" contype="8" conaffinity="4" />
      <!-- Keep every marble-only helper inside the visible spoon footprint.
           This is a deliberately concave approximation of the YCB spoon bowl:
           the leading ramp stays low for scooping, while the raised side and
           trailing walls retain the marble during transport.  The front stays
