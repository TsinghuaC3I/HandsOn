<mujoco model="c01_wood_nail">
  <asset>
    <texture name="c01_ycb_wood_block_tex" type="2d"
             file="lightwheel_ycb/wood_block/visuals/T_wood_block_BC001.png"/>
    <material name="c01_ycb_wood_block_mat" texture="c01_ycb_wood_block_tex"
              specular="0.31"/>
    <mesh name="c01_ycb_wood_block_vis"
          file="lightwheel_ycb/wood_block/visuals/wood_block.obj"
          scale="1.176 0.349 0.529"/>

    <texture name="c01_ycb_nail_tex" type="2d"
             file="lightwheel_ycb/a_Nails/visuals/T_a_Nails_BC001.png"/>
    <material name="c01_ycb_nail_mat" texture="c01_ycb_nail_tex"
              specular="2" shininess="8"/>
    <mesh name="c01_ycb_nail_vis" file="lightwheel_ycb/a_Nails/visuals/a_Nails.obj"
          scale="3.25 3.24 3.25"/>
    <mesh name="c01_ycb_nail_collision"
          file="lightwheel_ycb/a_Nails/collision/a_Nails_Collider1_m.obj"
          scale="3.25 3.24 3.25"/>
  </asset>

  <worldbody>
    <body name="wood" pos="-0.10 0.10 0.9165" quat="1 0 0 0">
      <joint type="free" name="wood_joint" damping="0.001"/>
      <!--
        Keep the imported articulation's mass properties finite before PhysX
        starts.  These are the exact centered-box inertias for the 0.100 x
        0.070 x 0.045 m support collision at the task's 0.085 kg wood mass.
      -->
      <inertial pos="0 0 0" mass="0.085"
                diaginertia="0.00004905208333 0.00008517708333 0.0001055416667"/>
      <geom name="wood_collision" type="box" size="0.050 0.035 0.0225"
            friction="2.0 0.03 0.001" solref="0.006 1.0"
            solimp="0.95 0.99 0.001" condim="4" contype="3" conaffinity="3"
            group="3"/>
      <geom name="wood_visual" type="mesh" mesh="c01_ycb_wood_block_vis"
            contype="0" conaffinity="0" group="1" mass="0"
            material="c01_ycb_wood_block_mat"/>
      <site name="wood_top" pos="0 0 0.0225" size="0.002 0.002 0.002" rgba="0 0 0 0"/>

      <body name="nail" pos="0 0 0.0695" quat="1 0 0 0">
        <joint name="nail_slide_joint" type="slide" axis="0 0 1"
               range="-0.03 0" damping="2.0" frictionloss="0.2" limited="true"/>
        <geom name="nail_visual" type="mesh" mesh="c01_ycb_nail_vis"
              material="c01_ycb_nail_mat" pos="0 0 -0.0321"
              quat="0.7071068 -0.7071068 0 0"
              contype="0" conaffinity="0" group="1" mass="0"/>
        <!-- The YCB collider shares the visual's scale and transform exactly. -->
        <geom name="nail_head" type="mesh" mesh="c01_ycb_nail_collision"
              pos="0 0 -0.0321" quat="0.7071068 -0.7071068 0 0"
              density="3386.234" rgba="0 0 0 0" group="3"
              friction="1.0 0.1 0.01" solref="0.005 1.0"
              solimp="0.95 0.99 0.001" condim="4" contype="3" conaffinity="3"/>
        <!--
          Preserve the legacy name used by contact telemetry.  This tiny,
          massless shape is fully enclosed by the matching YCB collider, so
          runtime code may continue to resolve ``nail_shaft`` without adding
          an oversized external collision surface.
        -->
        <geom name="nail_shaft" type="cylinder" pos="0 0 -0.0321" quat="1 0 0 0"
              size="0.0001 0.0001" mass="0" rgba="0 0 0 0" group="3"
              friction="2.0 0.5 0.1" solref="0.005 1.0"
              solimp="0.95 0.99 0.001" condim="4" contype="3" conaffinity="3"/>
        <site name="nail_top_site" pos="0 0 0.0073" rgba="1 0 0 0" size="0.005"/>
        <site name="nail_bottom_site" pos="0 0 -0.0363" rgba="0 1 0 0" size="0.005"/>
        <site name="nail_center_site" pos="0 0 0" rgba="0 0 1 0" size="0.005"/>
      </body>
    </body>
  </worldbody>
</mujoco>
