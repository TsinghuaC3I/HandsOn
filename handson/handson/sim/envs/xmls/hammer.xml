            contype="3" conaffinity="3" condim="6"
            rgba="0 0 0 0" group="3" solref="0.005 1.0" solimp="0.95 0.99 0.001"/>
      <geom name="hammer_collision_12" type="mesh" mesh="c01_ycb_hammer_col_12"
