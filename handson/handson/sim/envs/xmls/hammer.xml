    <texture name="c01_ycb_hammer_tex" type="2d"
             file="lightwheel_ycb/hammer/visuals/T_hammer_BC001.png"/>
    <material name="c01_ycb_hammer_mat" texture="c01_ycb_hammer_tex"
              specular="0.3" shininess="0.5"/>
    <mesh name="c01_ycb_hammer_vis" file="lightwheel_ycb/hammer/visuals/optimized_visuals/hammer.obj"/>
    <mesh name="c01_ycb_hammer_col_01" file="lightwheel_ycb/hammer/collision/hammer_Collider1_m.obj"/>
    <mesh name="c01_ycb_hammer_col_02" file="lightwheel_ycb/hammer/collision/hammer_Collider2_m.obj"/>
    <mesh name="c01_ycb_hammer_col_03" file="lightwheel_ycb/hammer/collision/hammer_Collider3_m.obj"/>
