<?xml version="1.0" encoding="utf-8"?>
<mujoco model="loaded_tray_through_narrow_gate_objects">
  <asset>
    <!-- Transparent converter scaffolds only.  The selected downloaded tray
         USD is the sole visible tray in the production runtime. -->
    <material name="ltng_tray_red" rgba="0 0 0 0" />
    <material name="ltng_tray_dark" rgba="0 0 0 0" />
    <material name="ltng_goal_green" rgba="0.10 0.68 0.25 0.65" specular="0.02" shininess="0.02" />

    <!-- Reuse the production D09 cup and Lightwheel-YCB can in place.  The
         D09 visual is millimetre-authored and Y-up; its 880 scale includes
         the BC005 0.88 fit, while the geom's X+90 rotation makes it Z-up. -->
    <texture type="2d" name="loaded_tray_cup_texture"
             file="assets/t31_prepare_coffee/textures/mug_base_color.png" />
    <material name="loaded_tray_cup_material" texture="loaded_tray_cup_texture"
              specular="0.30" shininess="0.45" />
    <mesh name="loaded_tray_cup_visual_mesh"
          file="assets/t31_prepare_coffee/d09_mug_visual.obj"
          scale="880 880 880" />
    <mesh name="loaded_tray_cup_body_collision_mesh"
          file="assets/t31_prepare_coffee/d09_mug_body_collision.obj"
          scale="0.88 0.88 0.88" />
    <mesh name="loaded_tray_cup_handle_upper_collision_mesh"
          file="assets/t31_prepare_coffee/d09_mug_handle_upper_collision.obj"
          scale="0.88 0.88 0.88" />
    <mesh name="loaded_tray_cup_handle_outer_collision_mesh"
          file="assets/t31_prepare_coffee/d09_mug_handle_outer_collision.obj"
          scale="0.88 0.88 0.88" />
    <mesh name="loaded_tray_cup_handle_lower_collision_mesh"
          file="assets/t31_prepare_coffee/d09_mug_handle_lower_collision.obj"
          scale="0.88 0.88 0.88" />

    <texture type="2d" name="loaded_tray_can_texture"
             file="lightwheel_ycb/tomato_soup_can/visuals/T_tomato_soup_can_BC001.png" />
    <material name="loaded_tray_can_material" texture="loaded_tray_can_texture"
              specular="0.31" shininess="0.30" />
    <mesh name="loaded_tray_can_visual_mesh"
          file="lightwheel_ycb/tomato_soup_can/visuals/tomato_soup_can.obj" />
    <mesh name="loaded_tray_can_collision_mesh"
          file="lightwheel_ycb/tomato_soup_can/collision/tomato_soup_can_Collider1_m.obj" />
  </asset>

  <worldbody>
    <!-- The tray is one dynamic compound rigid body.  Every payload below is
         independent; none is welded or kinematically attached to the tray. -->
