<?xml version='1.0' encoding='utf-8'?>
<mujoco model="Rokae_Wuji2_YCB_Tasks">
  <include file="rokae_wuji2_bimanual.xml" />
  <include file="bucket.xml" />
  <include file="a_series_ycb_task_objects.xml" />

  <option timestep=".002" noslip_iterations="0" noslip_tolerance="0" />
  <statistic center="0.3 0 0.4" extent=".8" />

  <visual>
    <headlight diffuse=".25 .25 .25" ambient=".28 .28 .28" />
    <global azimuth="160" elevation="-20" offheight="2048" offwidth="2048" />
    <quality offsamples="8" />
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1=".3 .5 .7" rgb2="0 0 0" width="32" height="512" />
    <texture file="./table_arena/textures/light-gray-floor-tile.png" type="2d" name="texplane"/>
    <material name="floorplane" reflectance="0.01" shininess="0.0" specular="0.0" texrepeat="2 2" texture="texplane" texuniform="true"/>
    <texture name="tex-ycb-table-ceramic" type="2d" builtin="flat" width="1" height="1" rgb1="0.72 0.72 0.68" rgb2="0.72 0.72 0.68"/>
    <material name="table_ceramic" reflectance="0.0" shininess="0.0" specular="0.2" texrepeat="1 1" texture="tex-ycb-table-ceramic"/>
    <texture file="./table_arena/textures/steel-brushed.png" type="cube" name="tex-ycb-steel-brushed"/>
    <material name="table_legs_metal" reflectance="0.8" shininess="0.8" texrepeat="1 1" texture="tex-ycb-steel-brushed"/>
    <texture file="./table_arena/textures/light-gray-plaster.png" type="2d" name="tex-ycb-light-gray-plaster"/>
    <material name="walls_mat" reflectance="0.0" shininess="0.1" specular="0.1" texrepeat="3 3" texture="tex-ycb-light-gray-plaster" texuniform="true" />

    <material name="ycb_yellow" rgba="0.95 0.75 0.12 1" specular="0.2" shininess="0.2"/>
    <material name="ycb_apple_red" rgba="0.75 0.05 0.04 1" specular="0.25" shininess="0.25"/>
    <material name="ycb_orange" rgba="1.0 0.42 0.08 1" specular="0.2" shininess="0.2"/>
    <material name="ycb_pear_green" rgba="0.55 0.73 0.21 1" specular="0.2" shininess="0.2"/>
    <material name="ycb_box_blue" rgba="0.08 0.24 0.75 1" specular="0.25" shininess="0.25"/>
    <material name="ycb_box_yellow" rgba="0.93 0.75 0.16 1" specular="0.25" shininess="0.25"/>
    <material name="ycb_box_purple" rgba="0.47 0.25 0.72 1" specular="0.25" shininess="0.25"/>
    <material name="ycb_mug" rgba="0.9 0.9 0.86 1" specular="0.4" shininess="0.35"/>
    <material name="ycb_tennis" rgba="0.70 0.88 0.12 1" specular="0.2" shininess="0.2"/>
    <material name="ycb_golf" rgba="0.96 0.96 0.92 1" specular="0.2" shininess="0.2"/>
    <material name="ycb_soccer" rgba="0.05 0.05 0.05 1" specular="0.15" shininess="0.1"/>
    <material name="ycb_soccer_white" rgba="0.95 0.95 0.92 1" specular="0.15" shininess="0.1"/>
    <material name="ycb_bowl" rgba="0.15 0.22 0.85 1" specular="0.35" shininess="0.3"/>
    <material name="handson_tray" rgba="0.48 0.50 0.48 1" specular="0.3" shininess="0.2"/>
    <material name="rubiks_black" rgba="0.02 0.02 0.02 1" specular="0.2" shininess="0.2"/>
    <material name="rubiks_red" rgba="0.85 0.02 0.02 1"/>
    <material name="rubiks_green" rgba="0.02 0.65 0.09 1"/>
    <material name="rubiks_blue" rgba="0.02 0.20 0.85 1"/>
    <material name="rubiks_yellow" rgba="0.98 0.86 0.05 1"/>
    <material name="rubiks_orange" rgba="0.98 0.42 0.03 1"/>
    <material name="rubiks_white" rgba="0.95 0.95 0.92 1"/>
  </asset>

  <default>
    <default class="ycb_proxy">
      <joint limited="false" damping="0.001" armature="0.0001"/>
      <geom group="1" condim="4" friction="1.2 0.04 0.004" solref="0.003 1" solimp="0.95 0.99 0.001"/>
    </default>
  </default>

  <worldbody>
    <geom name="floor" size="3 3 0.01" type="plane" material="floorplane"/>

    <geom pos="-1.25 2.25 1.5" quat="0.6532815 0.6532815 0.2705981 0.2705981"
          size="1.06 1.5 0.01" type="box" conaffinity="0" contype="0" group="1" name="wall_leftcorner_visual" material="walls_mat"/>
    <geom pos="-1.25 -2.25 1.5" quat="0.6532815 0.6532815 -0.2705981 -0.2705981"
          size="1.06 1.5 0.01" type="box" conaffinity="0" contype="0" group="1" name="wall_rightcorner_visual" material="walls_mat"/>
    <geom pos="1.25 3 1.5" quat="0.7071 0.7071 0 0"
