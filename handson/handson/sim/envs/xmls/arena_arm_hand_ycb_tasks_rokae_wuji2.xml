    <body name="table" pos="-0.15 0 0">
      <geom name="table_collision" type="box" size="0.4 0.8 0.03" pos="0 0 0.86" friction="1 0.005 0.0001" group="3"/>
      <geom name="table_visual" type="box" size="0.4 0.8 0.03" pos="0 0 0.86" contype="0" conaffinity="0" group="1" material="table_ceramic"/>
      <site name="table_top" pos="0 0 0.89" size="0.002 0.002 0.002" rgba="0 0 0 0"/>
      <geom pos="0.32 0.72 0.43" type="cylinder" size="0.04 0.43" contype="0" conaffinity="0" group="1" material="table_legs_metal"/>
      <geom pos="0.32 -0.72 0.43" type="cylinder" size="0.04 0.43" contype="0" conaffinity="0" group="1" material="table_legs_metal"/>
      <geom pos="-0.32 0.72 0.43" type="cylinder" size="0.04 0.43" contype="0" conaffinity="0" group="1" material="table_legs_metal"/>
      <geom pos="-0.32 -0.72 0.43" type="cylinder" size="0.04 0.43" contype="0" conaffinity="0" group="1" material="table_legs_metal"/>
    </body>

    <camera name="front" pos="1.3 0.0 1.6" quat="0.5963678 0.3799282 0.3799282 0.5963678" fovy="45" />
    <camera name="back" pos="-0.8 0.0 0.7" quat="-0.5963678 -0.3799282 0.3799282 0.5963678" fovy="45" />
    <camera name="left" pos="-1 0.8 2" quat="-0.353500 -0.146424 0.353500 0.853424" fovy="45" />
    <camera name="right" pos="-1 -0.8 2" quat="0.853424 0.353500 -0.146424 -0.353500" fovy="45" />
    <camera name="top0" pos="0.17 0 1.8" quat="0.707 0 0 -0.707" fovy="45" />
    <light pos="0 0 3" dir="0 0 -1" diffuse=".6 .6 .6" specular=".06 .06 .06" />
    <body name="target" pos=".15 0 .5" quat="0 1 0 0" mocap="true">
      <geom name="target" type="box" size=".03 .03 .03" contype="0" conaffinity="0" rgba=".6 .3 .3 0" />
    </body>

  </worldbody>

  <sensor>
    <framepos name="bucket_pos" objtype="body" objname="bucket" />
    <framequat name="bucket_quat" objtype="body" objname="bucket" />
    <jointpos name="bucket_joint_pos" joint="bucket_joint_0" />
    <jointvel name="bucket_joint_vel" joint="bucket_joint_0" />
  </sensor>
</mujoco>
