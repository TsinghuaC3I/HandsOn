<?xml version="1.0" encoding="utf-8"?>
<mujoco model="b02_nut_bolt_objects">
  <compiler angle="radian" />

  <default>
    <default class="b02_collision">
      <geom group="0" friction="1.15 0.018 0.0002" solref="0.004 1" solimp="0.95 0.995 0.001" />
    </default>
    <default class="b02_visual">
      <geom contype="0" conaffinity="0" group="1" mass="0" />
    </default>
    <default class="b02_marker">
      <geom contype="0" conaffinity="0" group="4" mass="0" />
      <site group="4" />
    </default>
  </default>

  <asset>
    <texture type="2d" name="b02_bolt_tex" file="lightwheel_ycb/plastic_bolt/visuals/T_plastic_bolt_BC001.png" />
    <material name="b02_bolt_mat" texture="b02_bolt_tex" specular="0.35" shininess="0.5" />
    <mesh name="b02_bolt_vis" file="lightwheel_ycb/plastic_bolt/visuals/plastic_bolt.obj" />

    <texture type="2d" name="b02_nut_tex" file="lightwheel_ycb/plastic_nut/visuals/T_plastic_nut_BC001.png" />
    <material name="b02_nut_mat" texture="b02_nut_tex" specular="0.25" shininess="0.45" />
    <mesh name="b02_nut_vis" file="lightwheel_ycb/plastic_nut/visuals/plastic_nut.obj" />
    <mesh name="b02_nut_collision_mesh_1" file="lightwheel_ycb/plastic_nut/collision/plastic_nut_Collider1_m.obj" />
    <mesh name="b02_nut_collision_mesh_2" file="lightwheel_ycb/plastic_nut/collision/plastic_nut_Collider2_m.obj" />
    <mesh name="b02_nut_collision_mesh_3" file="lightwheel_ycb/plastic_nut/collision/plastic_nut_Collider3_m.obj" />
    <mesh name="b02_nut_collision_mesh_4" file="lightwheel_ycb/plastic_nut/collision/plastic_nut_Collider4_m.obj" />
    <mesh name="b02_nut_collision_mesh_5" file="lightwheel_ycb/plastic_nut/collision/plastic_nut_Collider5_m.obj" />
    <mesh name="b02_nut_collision_mesh_6" file="lightwheel_ycb/plastic_nut/collision/plastic_nut_Collider6_m.obj" />

    <material name="b02_target_mat" rgba="0.16 0.80 0.34 0.25" specular="0" shininess="0" />
    <material name="b02_thread_mat" rgba="0.90 0.82 0.28 0.55" specular="0.1" shininess="0.2" />
  </asset>

  <worldbody>
    <body name="bolt_root_body" pos="0.06 0.12 0.92" quat="1 0 0 0">
      <body name="bolt_object">
        <geom name="b02_bolt_visual" class="b02_visual" type="mesh" mesh="b02_bolt_vis" material="b02_bolt_mat" pos="0 0 0.026" quat="0.7071068 0.7071068 0 0" />
        <geom name="b02_bolt_head_collision" class="b02_collision" type="cylinder" size="0.0085 0.0035" pos="0 0 0.0035" density="960" rgba="0.18 0.18 0.18 0.22" />
        <geom name="b02_bolt_shaft_collision" class="b02_collision" type="cylinder" size="0.00445 0.027" pos="0 0 0.031" density="960" friction="0.22 0.003 0.0001" rgba="0.18 0.18 0.18 0.18" />
        <geom name="b02_bolt_thread_visual" class="b02_visual" type="cylinder" size="0.0048 0.027" pos="0 0 0.031" material="b02_thread_mat" />
        <geom name="b02_nut_target_depth" class="b02_visual" type="cylinder" size="0.014 0.0012" pos="0 0 0.032" material="b02_target_mat" />
        <site name="b02_bolt_base" pos="0 0 0" size="0.004" rgba="0.1 0.7 0.25 0.55" />
        <site name="b02_bolt_axis_top" pos="0 0 0.058" size="0.003" rgba="0.1 0.7 0.25 0.55" />
      </body>
    </body>

    <!-- This plane collides only with the nut (collision bit 4).  The B02
         environment moves it down by the accumulated thread pitch. -->
    <body name="b02_thread_support_body" pos="0 0 -1">
      <geom name="b02_thread_support" type="plane" size="0.02 0.02 0.001"
            contype="0" conaffinity="4" group="3" mass="0" rgba="0 0 0 0"
            condim="6" priority="5" friction="0.30 0.003 0.0001"
            solref="0.0015 1" solimp="0.995 0.999 0.0001" />
    </body>

    <body name="nut_root_body" pos="-0.20 0.22 0.932" quat="1 0 0 0">
      <freejoint name="nut_root" />
      <body name="nut_object">
        <geom name="b02_nut_visual" class="b02_visual" type="mesh" mesh="b02_nut_vis" material="b02_nut_mat" />
        <!-- The source mesh is already split into six convex ring segments.  Using
             those segments keeps the collision boundary on the visible nut and
             leaves only a narrow guide clearance around the bolt. -->
        <geom name="b02_nut_collision_0" class="b02_collision" type="mesh" mesh="b02_nut_collision_mesh_1" contype="5" density="940" friction="0.42 0.004 0.0001" rgba="0.72 0.14 0.10 0.28" />
        <geom name="b02_nut_collision_1" class="b02_collision" type="mesh" mesh="b02_nut_collision_mesh_2" contype="5" density="940" friction="0.42 0.004 0.0001" rgba="0.72 0.14 0.10 0.28" />
        <geom name="b02_nut_collision_2" class="b02_collision" type="mesh" mesh="b02_nut_collision_mesh_3" contype="5" density="940" friction="0.42 0.004 0.0001" rgba="0.72 0.14 0.10 0.28" />
        <geom name="b02_nut_collision_3" class="b02_collision" type="mesh" mesh="b02_nut_collision_mesh_4" contype="5" density="940" friction="0.42 0.004 0.0001" rgba="0.72 0.14 0.10 0.28" />
        <geom name="b02_nut_collision_4" class="b02_collision" type="mesh" mesh="b02_nut_collision_mesh_5" contype="5" density="940" friction="0.42 0.004 0.0001" rgba="0.72 0.14 0.10 0.28" />
        <geom name="b02_nut_collision_5" class="b02_collision" type="mesh" mesh="b02_nut_collision_mesh_6" contype="5" density="940" friction="0.42 0.004 0.0001" rgba="0.72 0.14 0.10 0.28" />
        <!-- Blocks fingertips from hooking through the nut while remaining transparent
             to the bolt (hand collision bit 2 is enabled by the B02 environment). -->
        <geom name="b02_nut_finger_guard" type="cylinder" size="0.0046 0.0042"
              pos="0 0 0" contype="0" conaffinity="2" group="3" mass="0"
              rgba="0 0 0 0" solref="0.002 1" solimp="0.995 0.999 0.0001" />
        <site name="b02_nut_center" pos="0 0 0" size="0.004" rgba="0.85 0.1 0.1 0.65" />
        <site name="b02_nut_axis_top" pos="0 0 0.008" size="0.0025" rgba="0.85 0.1 0.1 0.55" />
        <site name="b02_nut_axis_bottom" pos="0 0 -0.008" size="0.0025" rgba="0.85 0.1 0.1 0.55" />
      </body>
    </body>
  </worldbody>
</mujoco>
