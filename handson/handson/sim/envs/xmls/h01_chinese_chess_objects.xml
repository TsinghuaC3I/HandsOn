  <default>
    <!-- A 44.25 mm diameter is about 79% of the 55.872 mm grid spacing.  Only
         X/Y are scaled so the source pieces retain their natural 15 mm
         thickness. -->
    <default class="h01_piece_mesh">
      <mesh scale="1.485 1.485 1"/>
    </default>
    <default class="h01_piece">
      <!-- Keep each piece fully dynamic.  The transparent analytic cylinder
           below is inscribed in the scaled 44.25 x 44.24 x 15 mm source mesh;
           its planar base avoids convex-mesh micro-rocking on the board. -->
      <joint limited="false" damping="2.0" armature="0.002"/>
      <!-- Keep board contact moderate while giving the side pinch more hold. -->
      <geom condim="4" friction="0.95 0.06 0.006" solref="0.01 1" solimp="0.92 0.98 0.005"/>
    </default>
  </default>
