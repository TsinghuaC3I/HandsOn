)
{
    def Xform "Normalized"
    {
        matrix4d xformOp:transform = ( (0.0006978960571727079, 0, 0, 0), (0, 0, 0.0006978960571727079, 0), (0, -0.0006978960571727079, 0, 0), (-0.00015749409567638258, 0.0005774643428298488, -0.021110376210374447, 1) )
        uniform token[] xformOpOrder = ["xformOp:transform"]

        def Xform "Source" (
            prepend references = @source/converted_scene.usd@</World>
        )
        {
            over "Salt_and_Pepper_Shakers_FBX"
            {
                over "RootNode"
                {
                    over "Salt" (
                        active = false
                    )
                    {
                    }

                    over "Peeper"
                    {
                        over "Peeper_01___Default_0"
                        {
                            over "Peeper_01___Default_0" (
                                prepend apiSchemas = ["PhysicsCollisionAPI", "PhysicsMeshCollisionAPI", "PhysxCollisionAPI"]
                                customData = {
                                    dictionary handson = {
                                        string collisionRole = "source-derived visual convex hull"
                                    }
                                }
                            )
                            {
                                uniform token physics:approximation = "convexHull"
                                bool physics:collisionEnabled = 1
                                float physxCollision:contactOffset = 0.0015
                                float physxCollision:restOffset = 0
                            }
                        }

                        over "Peeper_02___Default_0"
                        {
                            over "Peeper_02___Default_0" (
                                prepend apiSchemas = ["PhysicsCollisionAPI", "PhysicsMeshCollisionAPI", "PhysxCollisionAPI"]
                                customData = {
