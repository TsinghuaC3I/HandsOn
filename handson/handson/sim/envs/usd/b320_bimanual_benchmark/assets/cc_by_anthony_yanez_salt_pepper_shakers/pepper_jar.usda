            string archiveSha256 = "a60fe7e5289422527695254baf4c6d98463fd71a3c5c5cd0c6e88696dcb9594d"
            string assetRole = "render-and-collision rigid object"
            string[] collisionSourceMeshes = ["/Asset/Normalized/Source/Salt_and_Pepper_Shakers_FBX/RootNode/Peeper/Peeper_01___Default_0/Peeper_01___Default_0", "/Asset/Normalized/Source/Salt_and_Pepper_Shakers_FBX/RootNode/Peeper/Peeper_02___Default_0/Peeper_02___Default_0"]
