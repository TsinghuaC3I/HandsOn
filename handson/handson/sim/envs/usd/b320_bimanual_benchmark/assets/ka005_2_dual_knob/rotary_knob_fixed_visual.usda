#usda 1.0
(
    defaultPrim = "RotaryKnobFixedVisual"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "RotaryKnobFixedVisual" (
    customData = {
        dictionary handson = {
            string author = "0x.anas"
            string license = "CC-BY-4.0"
            string source = "https://sketchfab.com/3d-models/rotary-knob-d3dd68a3c5ae4b3dbe861f2bcffa376e"
        }
    }
)
{
    def "Looks"
    {
        def Material "GreyPaintedMetal"
        {
            token outputs:surface.connect = </RotaryKnobFixedVisual/Looks/GreyPaintedMetal/PreviewSurface.outputs:surface>

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.34, 0.36, 0.38)
                color3f inputs:diffuseColor.connect = </RotaryKnobFixedVisual/Looks/GreyPaintedMetal/BaseColorTexture.outputs:rgb>
                float inputs:metallic = 0.65
                float inputs:metallic.connect = </RotaryKnobFixedVisual/Looks/GreyPaintedMetal/MetallicRoughnessTexture.outputs:b>
                float inputs:roughness = 0.38
                float inputs:roughness.connect = </RotaryKnobFixedVisual/Looks/GreyPaintedMetal/MetallicRoughnessTexture.outputs:g>
                token outputs:surface
            }

            def Shader "PrimvarReader_st"
            {
                uniform token info:id = "UsdPrimvarReader_float2"
                token inputs:varname = "st"
                float2 outputs:result
            }

            def Shader "BaseColorTexture"
            {
                uniform token info:id = "UsdUVTexture"
                asset inputs:file = @textures/Grey_painted_damaged_metal_baseColor.jpeg@
                token inputs:sourceColorSpace = "sRGB"
                float2 inputs:st.connect = </RotaryKnobFixedVisual/Looks/GreyPaintedMetal/PrimvarReader_st.outputs:result>
                float3 outputs:rgb
            }

            def Shader "MetallicRoughnessTexture"
            {
                uniform token info:id = "UsdUVTexture"
                asset inputs:file = @textures/Grey_painted_damaged_metal_metallicRoughness.png@
                token inputs:sourceColorSpace = "raw"
                float2 inputs:st.connect = </RotaryKnobFixedVisual/Looks/GreyPaintedMetal/PrimvarReader_st.outputs:result>
                float outputs:b
                float outputs:g
            }
        }
    }

    def Mesh "KnobBase" (
        prepend apiSchemas = ["MaterialBindingAPI"]
        customData = {
            dictionary handson = {
                string sourceNode = "Knob base_0"
                bool visualOnly = 1
            }
        }
    )
