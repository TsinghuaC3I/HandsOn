#usda 1.0
(
    defaultPrim = "RotaryKnobMovingVisual"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "RotaryKnobMovingVisual" (
    customData = {
        dictionary handson = {
            string author = "0x.anas"
            string license = "CC-BY-4.0"
            string rotationAxis = "+Z"
        }
    }
)
{
    def "Looks"
    {
        def Material "BlackNickel"
        {
            token outputs:surface.connect = </RotaryKnobMovingVisual/Looks/BlackNickel/PreviewSurface.outputs:surface>

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.06, 0.07, 0.08)
                color3f inputs:diffuseColor.connect = </RotaryKnobMovingVisual/Looks/BlackNickel/BaseColorTexture.outputs:rgb>
                float inputs:metallic = 0.65
                float inputs:metallic.connect = </RotaryKnobMovingVisual/Looks/BlackNickel/MetallicRoughnessTexture.outputs:b>
                float inputs:roughness = 0.38
                float inputs:roughness.connect = </RotaryKnobMovingVisual/Looks/BlackNickel/MetallicRoughnessTexture.outputs:g>
                token outputs:surface
            }

            def Shader "PrimvarReader_st"
            {
                uniform token info:id = "UsdPrimvarReader_float2"
                token inputs:varname = "st"
                float2 outputs:result
            }

            def Shader "BaseColorTexture"
            {
                uniform token info:id = "UsdUVTexture"
                asset inputs:file = @textures/Black_Nickel_baseColor.jpeg@
                token inputs:sourceColorSpace = "sRGB"
                float2 inputs:st.connect = </RotaryKnobMovingVisual/Looks/BlackNickel/PrimvarReader_st.outputs:result>
                float3 outputs:rgb
            }

            def Shader "MetallicRoughnessTexture"
            {
                uniform token info:id = "UsdUVTexture"
                asset inputs:file = @textures/Black_Nickel_metallicRoughness.png@
                token inputs:sourceColorSpace = "raw"
                float2 inputs:st.connect = </RotaryKnobMovingVisual/Looks/BlackNickel/PrimvarReader_st.outputs:result>
                float outputs:b
                float outputs:g
            }
        }

        def Material "Index"
        {
            token outputs:surface.connect = </RotaryKnobMovingVisual/Looks/Index/PreviewSurface.outputs:surface>

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.95, 0.62, 0.04)
                float inputs:metallic = 0
                float inputs:roughness = 0.3
                token outputs:surface
            }
        }
    }

    def Mesh "Grip" (
        prepend apiSchemas = ["MaterialBindingAPI"]
        customData = {
            dictionary handson = {
                string sourceNode = "Grip_1"
                bool visualOnly = 1
            }
        }
    )
    {
