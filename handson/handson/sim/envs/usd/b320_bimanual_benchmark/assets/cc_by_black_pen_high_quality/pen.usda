#usda 1.0
(
    defaultPrim = "Pen"
    kilogramsPerUnit = 1
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "Pen" (
    customData = {
        dictionary handson = {
            string license = "CC-BY-4.0"
            string title = "Black Pen High Quality / Pen_A"
        }
    }
)
{
    def "Looks"
    {
        def Material "PenMaterial"
        {
            token outputs:surface.connect = </Pen/Looks/PenMaterial/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor.connect = </Pen/Looks/PenMaterial/BaseColor.outputs:rgb>
                float inputs:metallic.connect = </Pen/Looks/PenMaterial/MetallicRoughness.outputs:b>
                normal3f inputs:normal.connect = </Pen/Looks/PenMaterial/Normal.outputs:rgb>
                float inputs:roughness.connect = </Pen/Looks/PenMaterial/MetallicRoughness.outputs:g>
                token outputs:surface
            }

            def Shader "ST"
            {
                uniform token info:id = "UsdPrimvarReader_float2"
                token inputs:varname = "st"
                float2 outputs:result
            }

            def Shader "BaseColor"
            {
                uniform token info:id = "UsdUVTexture"
                asset inputs:file = @source/textures/Pen_MTL_baseColor.png@
                token inputs:sourceColorSpace = "sRGB"
                float2 inputs:st.connect = </Pen/Looks/PenMaterial/ST.outputs:result>
                float3 outputs:rgb
            }

            def Shader "MetallicRoughness"
            {
                uniform token info:id = "UsdUVTexture"
                asset inputs:file = @source/textures/Pen_MTL_metallicRoughness.png@
                token inputs:sourceColorSpace = "raw"
                float2 inputs:st.connect = </Pen/Looks/PenMaterial/ST.outputs:result>
                float outputs:b
                float outputs:g
            }

            def Shader "Normal"
            {
                uniform token info:id = "UsdUVTexture"
                float4 inputs:bias = (-1, -1, -1, 0)
                asset inputs:file = @source/textures/Pen_MTL_normal.png@
                float4 inputs:scale = (2, 2, 2, 1)
                token inputs:sourceColorSpace = "raw"
                float2 inputs:st.connect = </Pen/Looks/PenMaterial/ST.outputs:result>
                float3 outputs:rgb
            }
        }
    }

    def Mesh "Geometry_00" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
