    def Scope "Looks"
    {
        def Material "LightCountertop"
        {
            token outputs:surface.connect = </HS005Assets/Looks/LightCountertop/PBR.outputs:surface>

            def Shader "PBR"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.68, 0.62, 0.52)
                float inputs:metallic = 0.02
                float inputs:roughness = 0.48
                token outputs:surface
            }
        }

        def Material "StainlessSink"
        {
            token outputs:surface.connect = </HS005Assets/Looks/StainlessSink/PBR.outputs:surface>

            def Shader "PBR"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.48, 0.52, 0.56)
                float inputs:metallic = 0.82
                float inputs:roughness = 0.28
                token outputs:surface
            }
        }
    }

