        double3 xformOp:translate = (-1.135, -2.8, 0.18151906)
        quatf xformOp:orient = (0.5, 0.5, -0.5, -0.5)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient"]

        def Xform "Visual" (
            prepend references = @../assets/modern_apartment_kitchen/modern_apartment_kitchen.usd@
        )
        {
            over "Plane_007_Wood049_0"
