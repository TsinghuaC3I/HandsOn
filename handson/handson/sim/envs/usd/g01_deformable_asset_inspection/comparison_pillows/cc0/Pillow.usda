    def Scope "Physics" {
        def Material "PhysicsMaterial" (
            prepend apiSchemas = ["OmniPhysicsBaseMaterialAPI", "OmniPhysicsDeformableMaterialAPI", "PhysxDeformableMaterialAPI"]
        ) {
            float omniphysics:youngsModulus = 400000.0
            float omniphysics:poissonsRatio = 0.33
            float omniphysics:density = 55.0
            float omniphysics:staticFriction = 1.80
            float omniphysics:dynamicFriction = 1.45
            float physxDeformableMaterial:elasticityDamping = 0.18
        }
    }
    def Scope "Looks" {
        def Material "Textile" {
            token outputs:surface.connect = </root/Looks/Textile/Shader.outputs:surface>
            def Shader "Shader" {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor.connect = </root/Looks/Textile/BaseColor.outputs:rgb>
                normal3f inputs:normal.connect = </root/Looks/Textile/Normal.outputs:rgb>
                float inputs:roughness = 0.82
                float inputs:metallic = 0.0
                token outputs:surface
            }
            def Shader "UV" {
                uniform token info:id = "UsdPrimvarReader_float2"
                token inputs:varname = "st"
                float2 outputs:result
            }
            def Shader "BaseColor" {
                uniform token info:id = "UsdUVTexture"
                asset inputs:file = @Pillow1_baseColor.png@
                token inputs:sourceColorSpace = "sRGB"
                float2 inputs:st.connect = </root/Looks/Textile/UV.outputs:result>
                float3 outputs:rgb
            }
            def Shader "Normal" {
                uniform token info:id = "UsdUVTexture"
                asset inputs:file = @Pillow1_normal.png@
                token inputs:sourceColorSpace = "raw"
                float4 inputs:scale = (2,2,2,1)
                float4 inputs:bias = (-1,-1,-1,0)
                float2 inputs:st.connect = </root/Looks/Textile/UV.outputs:result>
                float3 outputs:rgb
            }
        }
    }
}
