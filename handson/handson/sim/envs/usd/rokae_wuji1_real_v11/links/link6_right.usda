#usda 1.0
(defaultPrim = "Visual"; metersPerUnit = 1; upAxis = "Z")
def Xform "Visual" (references = @link6_right_geometry.usdc@</Visual>)
{
    over "_materials"
    {
        over "SpunAmberAnodizedMetal_001"
        {
            token outputs:mdl:surface.connect = </Visual/_materials/SpunAmberAnodizedMetal_001/IsaacSpunMetal.outputs:out>
            def Shader "IsaacSpunMetal"
            {
                uniform token info:implementationSource = "sourceAsset"
                uniform asset info:mdl:sourceAsset = @materials/SpunAnodizedMetal.mdl@
                uniform token info:mdl:sourceAsset:subIdentifier = "SpunAnodizedMetal"
                token outputs:out
            }
        }
    }
}
