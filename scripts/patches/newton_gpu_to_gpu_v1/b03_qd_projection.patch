diff --git a/mujoco_warp/_src/forward.py b/mujoco_warp/_src/forward.py
--- a/mujoco_warp/_src/forward.py
+++ b/mujoco_warp/_src/forward.py
@@ -130,6 +130,17 @@ def _next_velocity(
   qvel_out[worldid, dofid] = qvel_in[worldid, dofid] + qacc_scale_in * qacc_in[worldid, dofid] * timestep
 
 
+@wp.kernel
+def _project_dof_velocity(
+  qvel: wp.array2d[float],
+  velocity_limit: wp.array[float],
+):
+  """Project candidate generalized velocities before position integration."""
+  worldid, dofid = wp.tid()
+  limit = wp.abs(velocity_limit[dofid])
+  qvel[worldid, dofid] = wp.clamp(qvel[worldid, dofid], -limit, limit)
+
+
 @wp.kernel
 def _next_activation(
   # Model:
@@ -307,6 +318,19 @@ def _advance(m: Model, d: Data, qacc: wp.array, qvel: Optional[wp.array] = None):
     outputs=[d.qvel],
   )
 
+  # HANDSON_B03_NEWTON_QD_PROJECTION_V1: Newton's MuJoCo solver does not
+  # consume Model.joint_velocity_limit.  The adapter installs a template-DOF
+  # limit array on this MJWarp model, so project the candidate velocity before
+  # semi-implicit position integration.  This remains inside the integrator
+  # and therefore keeps MJWarp qvel, qpos, and Newton's state readback aligned.
+  dof_velocity_limit = getattr(m, "dof_velocity_limit", None)
+  if dof_velocity_limit is not None:
+    wp.launch(
+      _project_dof_velocity,
+      dim=(d.nworld, m.nv),
+      inputs=[d.qvel, dof_velocity_limit],
+    )
+
   # advance positions with qvel if given, d.qvel otherwise (semi-implicit)
   qvel_in = qvel or d.qvel
 
